# RelayMe Remote MCP Server Configuration
# Copy to a secure local file outside this repository, then replace values as needed.

# URL to the upstream RelayMe Controller
RELAYME_URL=https://controller.example.invalid:8765

# Optional default client token (used when remote clients do not provide Authorization: Bearer <token>)
# Leave unset or empty to enforce per-request client authentication (recommended for multi-tenant setups)
# RELAYME_TOKEN=CHANGE_ME_CLIENT_TOKEN

# Bind address and port
RELAYME_MCP_HOST=127.0.0.1
RELAYME_MCP_PORT=8000

# Remote transport: "streamable-http" (default for modern MCP clients), "sse", or "both"
RELAYME_MCP_TRANSPORT=streamable-http

# Task timeout in seconds (default: 35)
RELAYME_WAIT_SECONDS=35

# TLS settings for direct binding (required when host is non-loopback unless RELAYME_MCP_ALLOW_HTTP_INSECURE=true)
# RELAYME_MCP_TLS_CERT=/secure/local/path/server-cert.pem
# RELAYME_MCP_TLS_KEY=/secure/local/path/server-key.pem

# Reverse proxy setting: allow non-loopback HTTP if terminating TLS at Caddy, Cloudflare Tunnel, or Nginx
# RELAYME_MCP_ALLOW_HTTP_INSECURE=false

# Allowed origins for browser-based LLM clients (comma-separated, or leave empty for wildcard)
# RELAYME_MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# Allowed Host header values for DNS rebinding protection (comma-separated)
# RELAYME_MCP_ALLOWED_HOSTS=mcp.yourdomain.com,mcp.yourdomain.com:443

# Optional CA certificate when connecting to a Controller with a private CA
# RELAYME_CA_CERT=/secure/local/path/controller-ca.pem
