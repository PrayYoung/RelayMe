# RelayMe OAuth 2.1 Edge — environment variable reference
# Usage: relayme-mcp-oauth serve  (reads these from environment or use --flags)

# REQUIRED: Public HTTPS URL of this OAuth edge server (used in all discovery documents)
# Must be the exact URL that web MCP clients (Claude, Gemini) will reach.
# When using Cloudflare Tunnel: set this to the tunnel URL, e.g.
# RELAYME_OAUTH_BASE_URL=https://your-tunnel-name.trycloudflare.com
RELAYME_OAUTH_BASE_URL=https://your-public-https-url.example.com

# REQUIRED: RelayMe Controller base URL (same as used with relayme-mcp)
RELAYME_URL=https://100.x.y.z:18765

# Controller CA certificate (required if Controller uses a self-signed TLS cert)
RELAYME_CA_CERT=/Users/you/.config/relayme/controller-ca.pem

# OAuth SQLite database path (default: ~/.config/relayme/oauth.db)
# RELAYME_OAUTH_DB=~/.config/relayme/oauth.db

# Access token lifetime in seconds (default: 3600 = 1 hour)
# RELAYME_OAUTH_ACCESS_TTL=3600

# Refresh token lifetime in seconds (default: 86400 = 24 hours)
# RELAYME_OAUTH_REFRESH_TTL=86400

# Bind host for the OAuth edge server (default: 127.0.0.1)
# Use 0.0.0.0 only when deploying behind a TLS-terminating reverse proxy
# RELAYME_MCP_HOST=127.0.0.1

# Bind port (default: 8001 — distinct from relayme-mcp-remote on 8000)
# RELAYME_MCP_PORT=8001

# MCP transport: streamable-http (default), sse, or both
# RELAYME_MCP_TRANSPORT=streamable-http

# When binding to non-loopback without TLS: set to true only if behind a TLS proxy
# RELAYME_MCP_ALLOW_HTTP_INSECURE=false

# Comma-separated additional CORS allowed origins
# RELAYME_MCP_ALLOWED_ORIGINS=https://your-additional-origin.example.com

# Comma-separated additional Host header values (for DNS rebinding protection)
# RELAYME_MCP_ALLOWED_HOSTS=your-tunnel-hostname.trycloudflare.com

# TLS (optional — not needed when behind Cloudflare Tunnel or nginx TLS termination)
# RELAYME_MCP_TLS_CERT=/path/to/cert.pem
# RELAYME_MCP_TLS_KEY=/path/to/key.pem

# Task execution timeout in seconds (default: 35)
# RELAYME_WAIT_SECONDS=35

# DEV ONLY: Auto-approve /authorize with this sub identifier — NEVER use in production
# RELAYME_OAUTH_DEV_AUTO_APPROVE_SUB=test-user@example.com
